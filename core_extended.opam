opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/core_extended"
bug-reports: "https://github.com/public-release-reloaded/core_extended/issues"
dev-repo: "git+https://github.com/public-release-reloaded/core_extended.git#v0.18_preview.130.106+341+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/core_extended/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "bin_prot" {>= "v0.18~" & < "v0.19~"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "core_unix" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "ppx_stable_witness" {>= "v0.18~" & < "v0.19~"}
  "record_builder" {>= "v0.18~" & < "v0.19~"}
  "sexplib" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
  "re" {>= "1.8.0"}
]
available: arch != "x86_32"
synopsis: "Extra components that are not as closely vetted or as stable as Core"
description: "
The Core suite of libraries is an industrial strength alternative to
OCaml's standard library that was developed by Jane Street, the
largest industrial user of OCaml.
"
